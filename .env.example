# Copy to .env.local (git-ignored) and fill in from the Supabase dashboard:
# Project Settings -> API. Use the publishable (anon) key ONLY, never the
# service-role key. Restart `npx expo start` after changing these.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
