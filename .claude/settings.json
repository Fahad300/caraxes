{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm audit)",
      "Bash(npm outdated)",
      "Bash(npm ls*)",
      "Bash(npx *)",
      "Bash(yarn)",
      "Bash(yarn add *)",
      "Bash(yarn install)",
      "Bash(yarn run *)",
      "Bash(yarn test*)",
      "Bash(pnpm install)",
      "Bash(pnpm add *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(tsc)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(jest *)",
      "Bash(vitest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull)",
      "Bash(mkdir *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(pwd)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git rebase*)",
      "Bash(npm install -g*)",
      "Bash(npm uninstall*)",
      "Bash(yarn global*)",
      "Bash(pnpm add -g*)",
      "Bash(rm -rf*)",
      "Bash(rm -r*)"
    ],
    "deny": []
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
